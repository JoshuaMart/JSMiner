{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "JSMiner API",
    "version": "0.1.0",
    "description": "Offline content analysis with isolated webcrack, Wakaru, jsluice, TruffleHog, GraphQL and domain extractors and private source artifacts is implemented. URL acquisition and cache reuse remain unavailable."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Local development; use a private TLS reverse proxy for remote access"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Analysis",
      "description": "Bounded analysis contract"
    },
    {
      "name": "Sources",
      "description": "Private source manifest and bounded reads"
    },
    {
      "name": "Operations",
      "description": "Service health"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check service and metadata storage",
        "tags": [
          "Operations"
        ],
        "x-required-permissions": [
          "analysis:read"
        ],
        "responses": {
          "200": {
            "description": "Successful response (analysis may be partial or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission or capture policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "operationId": "analyze",
        "summary": "Analyze one script",
        "tags": [
          "Analysis"
        ],
        "x-required-permissions": [
          "analysis:write",
          "analysis:read"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response (analysis may be partial or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission or capture policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Script hash mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body or script too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type or encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid content or semantic parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Capacity or storage quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Delay before retrying in seconds"
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Capture failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Capture timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/source/{handle}": {
      "get": {
        "operationId": "listModules",
        "summary": "List module metadata",
        "tags": [
          "Sources"
        ],
        "x-required-permissions": [
          "source:read"
        ],
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            },
            "description": "Opaque handle bound to the authenticated project"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "See SourceListQuery"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "description": "See SourceListQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response (analysis may be partial or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManifestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission or capture policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Expired handle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/source/{handle}/{path}": {
      "get": {
        "operationId": "readModule",
        "summary": "Read a bounded source fragment",
        "tags": [
          "Sources"
        ],
        "x-required-permissions": [
          "source:read"
        ],
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            },
            "description": "Opaque handle bound to the authenticated project"
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ModulePath"
            },
            "description": "Logical path including slash-separated segments, e.g. original/bundle.js; treated as a wildcard route"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "default": 0
            },
            "description": "See SourceReadQuery"
          },
          {
            "name": "max_bytes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 4,
              "maximum": 65536,
              "default": 16384
            },
            "description": "See SourceReadQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response (analysis may be partial or failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission or capture policy denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or another project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Expired handle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "416": {
            "description": "Offset beyond module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid content or semantic parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque random token. Project and permissions are resolved server-side; not supplied by the request."
      }
    },
    "schemas": {
      "ToolName": {
        "type": "string",
        "enum": [
          "webcrack",
          "wakaru",
          "jsluice",
          "trufflehog",
          "graphql",
          "domains"
        ],
        "title": "ToolName"
      },
      "Hash": {
        "type": "string",
        "minLength": 71,
        "maxLength": 71,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "title": "Hash"
      },
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Identifier"
      },
      "HttpUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "format": "uri",
        "pattern": "^https?://[^\\s/?#]+(?:[/?#][^\\s]*)?$",
        "title": "HttpUrl"
      },
      "Domain": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
        "title": "Domain"
      },
      "ModulePath": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?:original|webcrack|wakaru)/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.(?:js|mjs|cjs|jsx|ts|tsx)$",
        "title": "ModulePath"
      },
      "AnalyzeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "$ref": "#/components/schemas/HttpUrl"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10485760
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolName"
            },
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true
          },
          "script_hash": {
            "$ref": "#/components/schemas/Hash"
          },
          "base_url": {
            "$ref": "#/components/schemas/HttpUrl"
          },
          "redact_query_values": {
            "type": "boolean",
            "default": false,
            "description": "Mask all endpoint query values. Detected secrets remain masked regardless of this option."
          },
          "min_confidence": {
            "$ref": "#/components/schemas/Confidence",
            "default": "low",
            "description": "Minimum confidence retained in all four finding categories."
          },
          "endpoint_scope": {
            "type": "string",
            "enum": [
              "all",
              "same_fqdn",
              "same_domain"
            ],
            "default": "all",
            "description": "Filter endpoints against base_url, or url when base_url is absent. same_domain uses the registrable domain including private public suffixes."
          },
          "exclude_extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^\\.?[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)*$"
            },
            "maxItems": 100,
            "uniqueItems": true,
            "default": [],
            "description": "Exclude endpoint path suffixes, case-insensitively, with an optional leading dot (e.g. css, .png, js.map). Query strings are ignored."
          },
          "reference_domains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Domain"
            },
            "minItems": 0,
            "maxItems": 20,
            "uniqueItems": true
          }
        },
        "required": [],
        "oneOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "content"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "endpoint_scope"
              ],
              "properties": {
                "endpoint_scope": {
                  "enum": [
                    "same_fqdn",
                    "same_domain"
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "base_url"
                  ]
                },
                {
                  "required": [
                    "url"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "required": [
                "tools"
              ],
              "properties": {
                "tools": {
                  "contains": {
                    "const": "domains"
                  }
                }
              }
            },
            "then": {
              "required": [
                "reference_domains"
              ],
              "properties": {
                "reference_domains": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "description": "Exactly one of url/content. content must also be well-formed Unicode and <= 10 MiB UTF-8 (runtime refinement). Explicit domains requires reference_domains.",
        "title": "AnalyzeRequest"
      },
      "Location": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start_byte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_byte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "start_byte",
          "end_byte"
        ],
        "title": "Location"
      },
      "Representation": {
        "type": "string",
        "enum": [
          "original",
          "webcrack",
          "wakaru"
        ],
        "title": "Representation"
      },
      "Confidence": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Confidence"
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "$ref": "#/components/schemas/ToolName"
          },
          "module_path": {
            "$ref": "#/components/schemas/ModulePath"
          },
          "representation": {
            "$ref": "#/components/schemas/Representation"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "tool",
          "module_path",
          "representation",
          "location"
        ],
        "title": "Evidence"
      },
      "SecretEvidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "jsluice",
              "trufflehog"
            ]
          },
          "module_path": {
            "$ref": "#/components/schemas/ModulePath"
          },
          "representation": {
            "$ref": "#/components/schemas/Representation"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?:jsluice|trufflehog):[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "tool",
          "module_path",
          "representation",
          "location",
          "rule_id"
        ],
        "title": "SecretEvidence"
      },
      "Endpoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "resolved_url": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HttpUrl"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[A-Z]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "http_call",
              "navigation",
              "resource",
              "literal"
            ]
          },
          "dynamic": {
            "type": "boolean"
          },
          "query_params": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          },
          "body_params": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 128,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "confidence",
          "evidence",
          "value",
          "resolved_url",
          "method",
          "kind",
          "dynamic",
          "query_params",
          "body_params"
        ],
        "title": "Endpoint"
      },
      "Secret": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecretEvidence"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?:jsluice|trufflehog):[A-Za-z0-9._-]+$"
          },
          "masked_value": {
            "const": "[REDACTED]",
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 76,
            "maxLength": 76,
            "pattern": "^hmac-sha256:[0-9a-f]{64}$"
          },
          "validation": {
            "type": "string",
            "const": "not_performed"
          }
        },
        "required": [
          "id",
          "confidence",
          "evidence",
          "kind",
          "rule_id",
          "masked_value",
          "fingerprint",
          "validation"
        ],
        "title": "Secret"
      },
      "GraphqlOperation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "operation_type": {
            "type": "string",
            "enum": [
              "query",
              "mutation",
              "subscription"
            ]
          },
          "name": {
